{
  "name": "basic-business-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Лёгкая открытая база бизнес-агентов",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "admin:create": "node --env-file=.env core/cli/admin.ts create",
    "admin:reset-password": "node --env-file=.env core/cli/admin.ts reset-password",
    "check:public": "node tooling/no-customer-data/cli.ts",
    "db:migrate": "node --env-file=.env core/cli/migrate.ts",
    "dev:db": "docker compose --env-file .env -f deploy/compose.dev.yaml up -d --wait",
    "lint": "eslint . && node tooling/architecture/cli.ts",
    "models:config": "node --env-file=.env core/cli/models-config.ts",
    "prepare": "git config core.hooksPath tooling/git-hooks",
    "start": "node core/server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@bba/contracts": "workspace:*",
    "@hono/node-server": "2.1.8",
    "@mastra/core": "1.83.0",
    "@mastra/editor": "0.17.1",
    "@mastra/mcp": "2.9.0",
    "@mastra/memory": "1.41.1",
    "@mastra/pg": "1.36.0",
    "better-auth": "1.7.22",
    "hono": "4.13.18",
    "pg": "8.23.1",
    "zod": "4.6.7"
  }
}

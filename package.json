{
  "name": "basic-business-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Лёгкая открытая база бизнес-агентов",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "admin:create": "node --env-file=.env core/cli/admin.ts create",
    "admin:reset-password": "node --env-file=.env core/cli/admin.ts reset-password",
    "build:web": "pnpm -C web build",
    "check:public": "node tooling/no-customer-data/cli.ts",
    "customer:new": "node core/cli/customer-new.ts",
    "db:migrate": "node --env-file=.env core/cli/migrate.ts",
    "dev": "pnpm dev:stack && pnpm run --parallel \"/^dev:(app|web)$/\"",
    "dev:app": "node --watch --env-file=.env core/server/main.ts",
    "dev:people": "node --env-file=.env tooling/dev-people.ts",
    "dev:db": "mkdir -p .data/chatgpt-auth-test && docker compose --env-file .env -f deploy/compose.dev.yaml up -d --wait",
    "dev:stack": "node --env-file=.env core/cli/gateway-config.ts --mkdir-auth && docker compose --env-file .env -f deploy/compose.dev.yaml -f deploy/compose.app.yaml up -d --wait",
    "dev:web": "pnpm -C web dev",
    "gateway:config": "node --env-file=.env core/cli/gateway-config.ts",
    "lint": "eslint . && node tooling/architecture/cli.ts",
    "prepare": "git config core.hooksPath tooling/git-hooks",
    "skills:pack": "node tooling/skills-pack.ts",
    "skills:setup": "uv venv .venv-skills --python-preference only-system --allow-existing && uv pip install --python .venv-skills/bin/python -r core/sandbox/requirements.txt && mkdir -p .venv-skills/node && cp core/sandbox/node/package.json core/sandbox/node/package-lock.json .venv-skills/node/ && npm ci --prefix .venv-skills/node --omit=dev --no-audit --no-fund",
    "smoke": "bash deploy/smoke.sh",
    "stand": "node --env-file=.env tests/e2e/stand.ts",
    "start": "node core/server/main.ts",
    "test": "vitest run && pnpm -C web test",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.4",
    "@ag-ui/core": "1.0.4",
    "@ag-ui/mastra": "2.0.2",
    "@bba/contracts": "workspace:*",
    "@copilotkit/runtime": "2.0.0-rc.49",
    "@hono/node-server": "2.1.8",
    "@mastra/core": "1.83.0",
    "@mastra/editor": "0.17.1",
    "@mastra/mcp": "2.9.0",
    "@mastra/memory": "1.41.1",
    "@mastra/pg": "1.36.0",
    "better-auth": "1.7.22",
    "croner": "10.0.1",
    "fflate": "0.8.2",
    "hono": "4.13.18",
    "pg": "8.23.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}

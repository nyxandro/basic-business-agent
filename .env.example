# Copy to .env and fill in. Only secrets and connection bindings live here;
# application behaviour is configured in config/ (spec, section 22).

# Development database (deploy/compose.dev.yaml)
POSTGRES_USER=bba
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bba
POSTGRES_PORT=54329
DATABASE_URL=postgresql://bba:change-me@127.0.0.1:54329/bba

# Server
APP_PUBLIC_URL=http://localhost:8080
# Random string of 32+ characters: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-characters-or-more

# LiteLLM with mock models for automated tests (deploy/compose.dev.yaml: litellm-test)
LITELLM_TEST_PORT=54400
LITELLM_TEST_URL=http://127.0.0.1:54400
LITELLM_TEST_MASTER_KEY=sk-test-master-change-me
LITELLM_TEST_CALLBACK_SECRET=change-me-test-callback-secret
# Encrypts provider keys in the test LiteLLM's database; never change it once models are stored
LITELLM_TEST_SALT_KEY=sk-change-me-test-salt

# Model gateway (LiteLLM of the installation, deploy/compose.dev.yaml: litellm)
LITELLM_PORT=4000
LITELLM_URL=http://127.0.0.1:4000
# Must start with sk-
LITELLM_MASTER_KEY=sk-change-me
# Random string of 32+ characters; LiteLLM sends it back with every usage record
LITELLM_CALLBACK_SECRET=change-me-to-a-random-string-of-32-characters-or-more
# Where LiteLLM sends usage records (pnpm gateway:config writes it into deploy/litellm/config.json).
# Development: the server runs on this machine, LiteLLM in Docker reaches it through host.docker.internal.
LITELLM_CALLBACK_URL=http://host.docker.internal:3000/app/api/internal/usage
# Encrypts provider keys in LiteLLM's database (models are added in «Нейросеть»); never change it
# once models are stored: openssl rand -hex 32
LITELLM_SALT_KEY=sk-change-me-salt
# SearXNG of the search of the internet (spec, section 8.30): any random string of 32+ characters.
SEARXNG_SECRET=change-me-searxng-secret-0123456789abcdef
# AES-256-GCM keys for secrets in the database: "<version>:<base64 of 32 bytes>", first one encrypts
# openssl rand -base64 32
APP_ENCRYPTION_KEYS=1:change-me-base64-32-bytes

# Employees' workspaces (absolute path; /workspace in the container)
APP_WORKSPACE_DIR=/tmp/bba-workspace
# Unpacked copies of the skills uploaded in «Скиллы» (absolute path); refilled from the database at start
APP_SKILLS_DIR=/tmp/bba-skills
# Login files of the ChatGPT accounts (absolute path), shared with LiteLLM (/chatgpt-auth in its container)
APP_CHATGPT_AUTH_DIR=/tmp/bba-chatgpt-auth

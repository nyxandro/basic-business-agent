# Copy to .env and fill in. Only secrets and connection bindings live here;
# application behaviour is configured in config/ (spec, section 22).

# Development database (deploy/compose.dev.yaml)
POSTGRES_USER=bba
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bba
POSTGRES_PORT=54329
DATABASE_URL=postgresql://bba:change-me@127.0.0.1:54329/bba

# Server
APP_PUBLIC_URL=http://localhost:8080
# Random string of 32+ characters: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-characters-or-more

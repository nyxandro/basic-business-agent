# Web server of an installation (spec, section 17.1): the built interface, and /app/api for the app.
# Nothing else of the app is reachable from outside; LiteLLM's usage records come inside Docker only.
# SITE_ADDRESS: ":80" behind a local port, or a domain name (Caddy then gets an HTTPS certificate).
{
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		# Pictures from our own server only (spec, section 8.30): a picture from another site in an answer of the
		# agent would carry out whatever was put into its address.
		Content-Security-Policy "img-src 'self' data: blob:"
		-Server
	}

	handle /app/api/internal* {
		respond 404
	}
	handle /app/api/* {
		reverse_proxy app:3000
	}
	# Addresses an engine might serve (Mastra's /api) do not exist in this installation.
	handle /api* {
		respond 404
	}
	# The browser's handler of notifications and the description of the app (docs/specs/[20.11.2026]-notifications.md):
	# never kept by a cache, or a fix to the handler would not reach the browsers.
	@fresh path /sw.js /manifest.webmanifest
	header @fresh Cache-Control "no-cache"
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

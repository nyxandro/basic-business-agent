# Installation (deploy/compose.yaml): copy to deploy/.env and fill in. Only secrets and bindings.
# Random values: openssl rand -base64 48 (secrets), openssl rand -base64 32 (encryption key).

POSTGRES_USER=bba
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bba

# Address people open; must match SITE_ADDRESS and the binds below.
APP_PUBLIC_URL=http://localhost:8080
# What Caddy serves: ":80" behind WEB_BIND, or a domain name (then HTTPS on 443).
SITE_ADDRESS=:80
# Host address:port for HTTP and HTTPS; a local start keeps them on 127.0.0.1.
WEB_BIND=127.0.0.1:8080
WEB_BIND_TLS=127.0.0.1:8443

BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-characters-or-more
# "<version>:<base64 of 32 bytes>"; the first one encrypts, older ones still decrypt.
APP_ENCRYPTION_KEYS=1:change-me-base64-32-bytes

# Must start with sk-
LITELLM_MASTER_KEY=sk-change-me
LITELLM_CALLBACK_SECRET=change-me-to-a-random-string-of-32-characters-or-more
# Key of the model provider named in config/models.ts
OPENAI_API_KEY=change-me

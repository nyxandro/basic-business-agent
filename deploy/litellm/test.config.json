  "litellm_settings": {
    "timezone": "Europe/Moscow",
    "callbacks": [
      "bba_ledger",
      "bba_account_events"
    ],
    "always_include_stream_usage": true,
    "turn_off_message_logging": true
  },
  "callback_settings": {
    "bba_ledger": {
      "callback_type": "generic_api",
      "endpoint": "http://host.docker.internal:39999/app/api/internal/usage",
      "log_format": "single",
      "event_types": [
        "llm_api_success"
      ],
      "headers": {
        "Authorization": "os.environ/LITELLM_CALLBACK_AUTHORIZATION"
      },
      "max_retries": 5,
      "retry_delay": 1
    },
    "bba_account_events": {
      "callback_type": "generic_api",
      "endpoint": "http://host.docker.internal:39999/app/api/internal/account-events",
      "log_format": "single",
      "event_types": [
        "llm_api_failure"
      ],
      "headers": {
        "Authorization": "os.environ/LITELLM_CALLBACK_AUTHORIZATION"
      },
      "max_retries": 5,
      "retry_delay": 1
    }
  },
  "search_tools": [
    {
      "search_tool_name": "web-search",
      "litellm_params": {
        "search_provider": "searxng",
        "api_base": "http://host.docker.internal:39997",
        "timeout": 15
      },
      "search_tool_info": {
        "description": "SearXNG of the installation"
      }
    }
  ],
  "router_settings": {
    "routing_strategy": "simple-shuffle",
    "num_retries": 1,
    "allowed_fails": 1,
    "cooldown_time": 60
  },
  "general_settings": {
    "master_key": "os.environ/LITELLM_MASTER_KEY",
    "database_url": "os.environ/DATABASE_URL",
    "store_model_in_db": true
  }
}
